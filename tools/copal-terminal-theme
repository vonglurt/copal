#
# copal-terminal-theme -- one light palette, Copal Sand, on every terminal.
#
#   copal-terminal-theme            write it into $HOME's terminal configs
#   copal-terminal-theme --show     print the palette and stop
#
# WHY. The desktop's terminal palette had been copied from a theme designed
# for a translucent, blurred window on a GPU: its "black" (colour 0) was
# #9400ff and its "white" (colour 7) #ff00ee, so any program printing in
# black, bold or dim came out purple on the light ground, and its selection
# colours equalled its background, so a selection was invisible. Half the
# bench's pictures showed it (docs/app-gallery.md, 2 Sep 2026).
#
# THE PALETTE. Sand ground, coffee text; rust for red, sage for green, ochre
# for yellow, oasis blue, terracotta for magenta, turquoise for cyan, dune for
# "white". Every one of the eighteen colours reads at 4.5:1 or better against
# the ground (WCAG AA for text), the selection is a gold you can see, and the
# cursor is rust. Bright variants are a shade darker, not lighter: on a light
# ground "bright" has to mean "more saturated" or it disappears.
#
# WHAT IT WRITES. Each terminal's own format, idempotently, leaving the rest
# of the file alone where the file already exists:
#   foot          ~/.config/foot/foot.ini              [colors-light]/[colors-dark] replaced
#   kitty         ~/.config/kitty/copal-sand.conf      + the include in kitty.conf
#   alacritty     ~/.config/alacritty/copal-sand.toml  + import in alacritty.toml
#   wezterm       ~/.config/wezterm/colors/copal-sand.toml + wezterm.lua if absent
#   xterm, urxvt  ~/.Xresources                        a marked block, merged with xrdb
#   sakura        ~/.config/sakura/sakura.conf         colorset 1 fore/back/cursor
#   lxterminal    ~/.config/lxterminal/lxterminal.conf fg/bg/palette keys
#   xfce4-term    ~/.config/xfce4/terminal/terminalrc  Color* keys
#   terminator    ~/.config/terminator/config          default profile colours
#   tilda         ~/.config/tilda/config_0             colours (if the file exists)
#   qterminal     ~/.local/share/qtermwidget6/color-schemes/CopalSand.colorscheme
#                 + colorScheme=CopalSand in qterminal.ini
# st compiles its colours in; Cool Retro Term is amber on purpose. Both are left.
set -u

BG=f4ead6; FG=3a2c20; CURSOR=b7410e; SELBG=e6c98c; SELFG=2b2118
# 0..15: black red green yellow blue magenta cyan white, then the brights
C0=3b2f2f;  C1=b7410e;  C2=4f6a2a;  C3=8a5a00;  C4=2f6f8f;  C5=9a4a6a;  C6=1d7361;  C7=75634f
C8=6b5b4b;  C9=a83a0a;  C10=526f28; C11=8c5f04; C12=256f8c; C13=8f3f66; C14=1f7866; C15=5a4a3c
NAMES="black red green yellow blue magenta cyan white"

col() { eval "printf '%s' \"\$C$1\""; }
rgb() {  # hex -> "r,g,b" decimal
    printf '%d,%d,%d' "0x$(printf '%s' "$1" | cut -c1-2)" "0x$(printf '%s' "$1" | cut -c3-4)" "0x$(printf '%s' "$1" | cut -c5-6)"
}
rgb16() {  # hex -> "r,g,b" in 16-bit, for tilda
    printf '%d,%d,%d' $(( 0x$(printf '%s' "$1" | cut -c1-2) * 257 )) $(( 0x$(printf '%s' "$1" | cut -c3-4) * 257 )) $(( 0x$(printf '%s' "$1" | cut -c5-6) * 257 ))
}
say() { printf '  %s\n' "$*"; }

if [ "${1:-}" = "--show" ]; then
    printf 'Copal Sand: background #%s foreground #%s cursor #%s selection #%s on #%s\n' "$BG" "$FG" "$CURSOR" "$SELFG" "$SELBG"
    i=0; for n in $NAMES; do printf '  %2d %-8s #%s   %2d bright %-8s #%s\n' $i "$n" "$(col $i)" $((i+8)) "$n" "$(col $((i+8)))"; i=$((i+1)); done
    exit 0
fi

# Replace the text between two marker lines in a file, or append the block.
# $1 file, $2 begin marker, $3 end marker, stdin the new body (markers included).
replace_block() {
    _f="$1"; _b="$2"; _e="$3"; _new=$(cat)
    mkdir -p "$(dirname "$_f")"
    if [ -f "$_f" ] && grep -qF "$_b" "$_f"; then
        awk -v b="$_b" -v e="$_e" -v new="$_new" '
            index($0, b) == 1 { print new; skip = 1; next }
            index($0, e) == 1 && skip { skip = 0; next }
            !skip { print }' "$_f" > "$_f.tmp" && mv "$_f.tmp" "$_f"
    else
        { [ -f "$_f" ] && cat "$_f"; printf '%s\n' "$_new"; } > "$_f.tmp" && mv "$_f.tmp" "$_f"
    fi
}

# --- foot ------------------------------------------------------------------
# The [colors] section is replaced whole; anything else (font, pad, bindings)
# stays. foot's own light/dark switch is pointed at it.
f="$HOME/.config/foot/foot.ini"
mkdir -p "$(dirname "$f")"
[ -f "$f" ] || printf 'font=JetBrains Mono:size=11\npad=8x8\n\n[scrollback]\nlines=3000\n' > "$f"
awk '
    /^\[/ { insec = ($0 ~ /^\[colors(-light|-dark)?\]/) }
    /^initial-color-theme=/ { next }
    !insec { print }' "$f" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' > "$f.tmp" && mv "$f.tmp" "$f"
# foot 1.20+ keeps a light and a dark palette and picks one with
# initial-color-theme (in the top-level section, so it goes first). Both get
# Sand: the toggle then changes nothing, which is the point of one palette.
{ printf 'initial-color-theme=light\n'; cat "$f"; } > "$f.tmp" && mv "$f.tmp" "$f"
foot_colors() {
    printf '\n[%s]\n# Copal Sand -- written by copal-terminal-theme; re-run it rather than edit.\n' "$1"
    printf 'alpha=1.0\nbackground=%s\nforeground=%s\n' "$BG" "$FG"
    i=0; while [ $i -lt 8 ]; do printf 'regular%d=%s\n' $i "$(col $i)"; i=$((i+1)); done
    i=0; while [ $i -lt 8 ]; do printf 'bright%d=%s\n' $i "$(col $((i+8)))"; i=$((i+1)); done
    printf 'selection-background=%s\nselection-foreground=%s\ncursor=%s %s\n' "$SELBG" "$SELFG" "$BG" "$CURSOR"
}
{ foot_colors colors-light; foot_colors colors-dark; } >> "$f"
say "$f"

# --- kitty -----------------------------------------------------------------
d="$HOME/.config/kitty"; mkdir -p "$d"
{
    printf '# Copal Sand -- written by copal-terminal-theme\n'
    printf 'background #%s\nforeground #%s\ncursor #%s\ncursor_text_color #%s\n' "$BG" "$FG" "$CURSOR" "$BG"
    printf 'selection_background #%s\nselection_foreground #%s\nbackground_opacity 1.0\n' "$SELBG" "$SELFG"
    i=0; while [ $i -lt 16 ]; do printf 'color%d #%s\n' $i "$(col $i)"; i=$((i+1)); done
} > "$d/copal-sand.conf"
k="$d/kitty.conf"
if [ -f "$k" ] && grep -q '^# BEGIN_KITTY_THEME' "$k"; then
    replace_block "$k" '# BEGIN_KITTY_THEME' '# END_KITTY_THEME' <<EOF
# BEGIN_KITTY_THEME
include copal-sand.conf
# END_KITTY_THEME
EOF
else
    grep -q 'include copal-sand.conf' "$k" 2>/dev/null || printf '# BEGIN_KITTY_THEME\ninclude copal-sand.conf\n# END_KITTY_THEME\n' >> "$k"
fi
say "$k"

# --- alacritty -------------------------------------------------------------
d="$HOME/.config/alacritty"; mkdir -p "$d"
{
    printf '# Copal Sand -- written by copal-terminal-theme\n[colors.primary]\nbackground = "#%s"\nforeground = "#%s"\n' "$BG" "$FG"
    printf '[colors.cursor]\ntext = "#%s"\ncursor = "#%s"\n' "$BG" "$CURSOR"
    printf '[colors.selection]\ntext = "#%s"\nbackground = "#%s"\n' "$SELFG" "$SELBG"
    printf '[colors.normal]\n'; i=0; for n in $NAMES; do printf '%s = "#%s"\n' "$n" "$(col $i)"; i=$((i+1)); done
    printf '[colors.bright]\n'; i=8; for n in $NAMES; do printf '%s = "#%s"\n' "$n" "$(col $i)"; i=$((i+1)); done
} > "$d/copal-sand.toml"
a="$d/alacritty.toml"
if [ ! -f "$a" ]; then
    printf '[general]\nimport = ["~/.config/alacritty/copal-sand.toml"]\n' > "$a"
elif ! grep -q 'copal-sand.toml' "$a"; then
    printf '\n[general]\nimport = ["~/.config/alacritty/copal-sand.toml"]\n' >> "$a"
fi
say "$a"

# --- wezterm ---------------------------------------------------------------
d="$HOME/.config/wezterm/colors"; mkdir -p "$d"
{
    printf '# Copal Sand -- written by copal-terminal-theme\n[colors]\nbackground = "#%s"\nforeground = "#%s"\n' "$BG" "$FG"
    printf 'cursor_bg = "#%s"\ncursor_fg = "#%s"\ncursor_border = "#%s"\n' "$CURSOR" "$BG" "$CURSOR"
    printf 'selection_bg = "#%s"\nselection_fg = "#%s"\n' "$SELBG" "$SELFG"
    printf 'ansi = ['; i=0; while [ $i -lt 8 ]; do printf '"#%s"%s' "$(col $i)" "$([ $i -lt 7 ] && printf ', ')"; i=$((i+1)); done; printf ']\n'
    printf 'brights = ['; i=8; while [ $i -lt 16 ]; do printf '"#%s"%s' "$(col $i)" "$([ $i -lt 15 ] && printf ', ')"; i=$((i+1)); done; printf ']\n'
    printf '[metadata]\nname = "Copal Sand"\n'
} > "$d/copal-sand.toml"
w="$HOME/.config/wezterm/wezterm.lua"
if [ ! -f "$w" ]; then
    printf 'local wezterm = require("wezterm")\nreturn { color_scheme = "Copal Sand" }\n' > "$w"
elif ! grep -q 'color_scheme' "$w"; then
    say "$w exists without a color_scheme line; add:  color_scheme = \"Copal Sand\""
fi
say "$d/copal-sand.toml"

# --- xterm and urxvt -------------------------------------------------------
# A marked block: the generic *color lines other X programs read are left
# to the desktop's own theme; these are XTerm- and URxvt-specific.
x="$HOME/.Xresources"
{
    printf '! >>> copal sand >>> written by copal-terminal-theme; re-run it rather than edit\n'
    for t in XTerm URxvt; do
        printf '%s*background: #%s\n%s*foreground: #%s\n%s*cursorColor: #%s\n' "$t" "$BG" "$t" "$FG" "$t" "$CURSOR"
        printf '%s*highlightColor: #%s\n%s*highlightTextColor: #%s\n' "$t" "$SELBG" "$t" "$SELFG"
        i=0; while [ $i -lt 16 ]; do printf '%s*color%d: #%s\n' "$t" $i "$(col $i)"; i=$((i+1)); done
    done
    printf '! <<< copal sand <<<\n'
} | replace_block "$x" '! >>> copal sand >>>' '! <<< copal sand <<<'
[ -n "${DISPLAY:-}" ] && command -v xrdb >/dev/null 2>&1 && xrdb -merge "$x" 2>/dev/null
say "$x"

# --- sakura ----------------------------------------------------------------
# Sakura's 16-colour palettes are built in; colour set 1 takes our ground,
# text and cursor, and 'tango' is the built-in palette that reads best on it.
s="$HOME/.config/sakura/sakura.conf"; mkdir -p "$(dirname "$s")"
[ -f "$s" ] || printf '[sakura]\n' > "$s"
for kv in "colorset1_fore=rgb($(rgb $FG))" "colorset1_back=rgb($(rgb $BG))" "colorset1_curs=rgb($(rgb $CURSOR))" "palette=tango" "last_colorset=1"; do
    key=${kv%%=*}
    if grep -q "^$key=" "$s"; then sed -i "s|^$key=.*|$kv|" "$s"; else printf '%s\n' "$kv" >> "$s"; fi
done
say "$s"

# --- lxterminal ------------------------------------------------------------
l="$HOME/.config/lxterminal/lxterminal.conf"; mkdir -p "$(dirname "$l")"
[ -f "$l" ] || printf '[general]\n' > "$l"
set -- "fgcolor=rgb($(rgb $FG))" "bgcolor=rgb($(rgb $BG))"
i=0; while [ $i -lt 16 ]; do set -- "$@" "palette_color_$i=rgb($(rgb "$(col $i)"))"; i=$((i+1)); done
for kv in "$@"; do
    key=${kv%%=*}
    if grep -q "^$key=" "$l"; then sed -i "s|^$key=.*|$kv|" "$l"; else printf '%s\n' "$kv" >> "$l"; fi
done
say "$l"

# --- xfce4-terminal --------------------------------------------------------
t="$HOME/.config/xfce4/terminal/terminalrc"; mkdir -p "$(dirname "$t")"
[ -f "$t" ] || printf '[Configuration]\n' > "$t"
pal=""; i=0; while [ $i -lt 16 ]; do pal="$pal#$(col $i);"; i=$((i+1)); done
for kv in "ColorForeground=#$FG" "ColorBackground=#$BG" "ColorCursor=#$CURSOR" "ColorCursorUseDefault=FALSE" \
          "ColorSelection=#$SELFG" "ColorSelectionBackground=#$SELBG" "ColorSelectionUseDefault=FALSE" "ColorPalette=${pal%;}"; do
    key=${kv%%=*}
    if grep -q "^$key=" "$t"; then sed -i "s|^$key=.*|$kv|" "$t"; else printf '%s\n' "$kv" >> "$t"; fi
done
say "$t"

# --- terminator ------------------------------------------------------------
# Written only when there is no config: Terminator's file is a nested INI
# that a sed cannot safely edit, and its own dialog writes it afterwards.
c="$HOME/.config/terminator/config"
if [ ! -f "$c" ]; then
    mkdir -p "$(dirname "$c")"
    pal=""; i=0; while [ $i -lt 16 ]; do pal="$pal#$(col $i):"; i=$((i+1)); done
    {
        printf '[global_config]\n[keybindings]\n[profiles]\n  [[default]]\n'
        printf '    background_color = "#%s"\n    foreground_color = "#%s"\n    cursor_color = "#%s"\n' "$BG" "$FG" "$CURSOR"
        printf '    palette = "%s"\n    use_theme_colors = False\n' "${pal%:}"
        printf '[layouts]\n  [[default]]\n    [[[window0]]]\n      type = Window\n      parent = ""\n    [[[child1]]]\n      type = Terminal\n      parent = window0\n[plugins]\n'
    } > "$c"
    say "$c"
else
    say "$c exists; not touched (Terminator's file is nested INI -- set the profile colours in its Preferences)"
fi

# --- tilda -----------------------------------------------------------------
# Tilda writes config_0 itself on first start; only an existing file is edited.
for c in "$HOME"/.config/tilda/config_*; do
    [ -f "$c" ] || continue
    pal=""; i=0; while [ $i -lt 16 ]; do pal="$pal$(rgb16 "$(col $i)"),"; i=$((i+1)); done
    for kv in "background_color=\"#$BG\"" "foreground_color=\"#$FG\"" "palette_scheme=0" "palette = {${pal%,}}"; do
        key=$(printf '%s' "$kv" | sed 's/ *=.*//')
        if grep -q "^$key *=" "$c"; then sed -i "s|^$key *=.*|$kv|" "$c"; else printf '%s\n' "$kv" >> "$c"; fi
    done
    say "$c"
done

# --- qterminal (qtermwidget) -----------------------------------------------
for v in qtermwidget6 qtermwidget5; do
    d="$HOME/.local/share/$v/color-schemes"; mkdir -p "$d"
    {
        printf '[Background]\nColor=%s\n[BackgroundIntense]\nColor=%s\n' "$(rgb $BG)" "$(rgb $BG)"
        printf '[Foreground]\nColor=%s\n[ForegroundIntense]\nColor=%s\n' "$(rgb $FG)" "$(rgb $C15)"
        i=0; while [ $i -lt 8 ]; do
            printf '[Color%d]\nColor=%s\n[Color%dIntense]\nColor=%s\n' $i "$(rgb "$(col $i)")" $i "$(rgb "$(col $((i+8)))")"
            i=$((i+1))
        done
        printf '[General]\nDescription=Copal Sand\nOpacity=1\n'
    } > "$d/CopalSand.colorscheme"
done
q="$HOME/.config/qterminal.org/qterminal.ini"
if [ -f "$q" ]; then
    if grep -q '^colorScheme=' "$q"; then sed -i 's|^colorScheme=.*|colorScheme=CopalSand|' "$q"; else printf 'colorScheme=CopalSand\n' >> "$q"; fi
else
    mkdir -p "$(dirname "$q")"; printf '[General]\ncolorScheme=CopalSand\n' > "$q"
fi
say "$q"

say "done: Copal Sand on every terminal that has a config file. New windows pick it up."
exit 0
